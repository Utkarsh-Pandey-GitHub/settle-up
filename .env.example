NODE_ENV=development
DATABASE_URL=postgresql://settleup:settleup_local@localhost:5432/settleup?schema=public
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-32-character-secret
# development (local test numbers), disabled (Truecaller only), gateway, supabase, or stytch
OTP_PROVIDER=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key can be used instead of the publishable key. No service-role key needed.
SUPABASE_ANON_KEY=
# Stytch OTP provider (https://stytch.com/dashboard)
STYTCH_PROJECT_ID=
STYTCH_SECRET=
# For Supabase DB: copy the Session pooler URL (port 5432) from Connect, append
# ?schema=settleup&sslmode=require&connection_limit=5 to DATABASE_URL above.
# The private settleup schema must NOT be added to Supabase's exposed API schemas.
# Only these fictional test numbers use the development provider.
DEV_PHONE_ALLOWLIST=+919876543210,+919876543211,+919876543212,+919876543213
# Production provider: signed HTTPS gateway; see docs/PROVIDERS.md
OTP_GATEWAY_URL=
OTP_GATEWAY_TOKEN=
PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000
# Demo data is fictional and never sent to the API.
EXPO_PUBLIC_DEMO=true
API_PUBLIC_URL=http://localhost:4000
STORAGE_PROVIDER=development
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_TOKEN=
# Optional native Expo project used to register push tokens:
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional Android Truecaller OAuth (same public client ID in both environments).
# Register app.settleup.mobile and its debug/production SHA-1 in Truecaller console.
# Rebuild the native app after changing this value. No client secret is used.
EXPO_PUBLIC_TRUECALLER_CLIENT_ID=
TRUECALLER_CLIENT_ID=

# Google OAuth client IDs are public identifiers. Create Android, iOS, and web
# clients only for platforms you ship. The API accepts a comma-separated list.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Optional HTTPS Play Store listing or public APK download shown on payment links.
APP_INSTALL_URL=
