NODE_ENV=development
DATABASE_URL=postgresql://settleup:settleup_local@localhost:5432/settleup?schema=public
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-32-character-secret
OTP_PROVIDER=development
# Only these fictional test numbers use the development provider.
DEV_PHONE_ALLOWLIST=+919876543210,+919876543211,+919876543212,+919876543213
# Production provider: signed HTTPS gateway; see docs/PROVIDERS.md
OTP_GATEWAY_URL=
OTP_GATEWAY_TOKEN=
PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000
# Demo data is fictional and never sent to the API.
EXPO_PUBLIC_DEMO=true
API_PUBLIC_URL=http://localhost:4000
STORAGE_PROVIDER=development
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_TOKEN=
# Optional native Expo project used to register push tokens:
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional Android Truecaller OAuth (same public client ID in both environments).
# Register app.settleup.mobile and its debug/production SHA-1 in Truecaller console.
# Rebuild the native app after changing this value. No client secret is used.
EXPO_PUBLIC_TRUECALLER_CLIENT_ID=
TRUECALLER_CLIENT_ID=
