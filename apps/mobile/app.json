{
  "expo": {
    "name": "SettleUp",
    "slug": "settleup",
    "scheme": ["settleup", "app.settleup.mobile"],
    "version": "1.0.14",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1a6df8cb-0a63-48c1-9e5c-a1754f54f226",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon-production.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.settleup.mobile"
    },
    "android": {
      "package": "app.settleup.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-production.png",
        "backgroundColor": "#F3F0FA"
      },
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "SettleUp",
      "favicon": "./assets/icon-production.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a UPI QR code after you choose to enable the camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose a person to split with. Your address book is not uploaded."
        }
      ],
      "expo-notifications",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a bill photo to attach or read its items.",
          "cameraPermission": "Take a bill photo or scan a UPI code.",
          "microphonePermission": false
        }
      ],
      "./modules/truecaller/app.plugin.js",
      "./with-upi-queries.js",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a6df8cb-0a63-48c1-9e5c-a1754f54f226"
      }
    }
  }
}
