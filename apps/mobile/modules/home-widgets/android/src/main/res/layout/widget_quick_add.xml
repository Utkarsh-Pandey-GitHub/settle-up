<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/quick_add_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_action_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="10dp"
  android:paddingEnd="10dp"
  android:contentDescription="@string/widget_quick_add_hint">

  <ImageView
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:padding="2dp"
    android:background="@drawable/widget_icon_circle"
    android:src="@drawable/widget_mascot_checklist"
    android:contentDescription="@null" />

  <LinearLayout
    android:id="@+id/quick_add_bar"
    android:layout_width="0dp"
    android:layout_height="40dp"
    android:layout_weight="1"
    android:layout_marginStart="10dp"
    android:background="@drawable/widget_input_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_quick_add_hint"
      android:textColor="#7A7388"
      android:textSize="13sp" />
    <TextView
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:background="@drawable/widget_send_bg"
      android:gravity="center"
      android:text="✦"
      android:textColor="#FFFFFF"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
